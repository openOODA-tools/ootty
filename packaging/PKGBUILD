# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ootty-bin
_pkgname=ootty
pkgver=0.1.0
pkgrel=1
pkgdesc="TTY capability inspection, pseudo-terminal allocation, and raw mode controller."
arch=('x86_64')
url="https://github.com/openOODA-tools/ootty"
license=('Apache-2.0')
depends=('glibc')
provides=('ootty')
conflicts=('ootty')
source_x86_64=("${url}/releases/download/v${pkgver}/ootty-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ootty-linux-x86_64" "${pkgdir}/usr/bin/ootty"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ootty-uninstall"
}
